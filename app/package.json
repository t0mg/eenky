{
  "name": "eenky",
  "productName": "EENK Story Editor",
  "version": "0.1.0",
  "description": "Ink editor, EENK compiler, SDL simulator and firmware flasher for the Xteink X4 device",
  "main": "main-process/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkle/inky.git"
  },
  "scripts": {
    "postinstall": "node ../build/createDocumentnavigation.js && markdown-html resources/Documentation/WritingWithInk.md -s resources/Documentation/documentation.css -o renderer/documentation/embedded.html",
    "setup": "node scripts/setup.js",
    "start": "electron main-process/main.js",
    "test": "./node_modules/mocha/bin/mocha",
    "generate-locale": "node ../build/generateLocale.js",
    "build-package": "node build-package.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.xteink.eenky",
    "productName": "EENK Story Editor",
    "directories": { "output": "../dist-eenky" },
    "extraResources": [
      { "from": "main-process/ink", "to": "ink", "filter": ["**/*"] },
      { "from": "../bin", "to": "bin", "filter": ["**/*"] }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.developer-tools" }
  },
  "keywords": [
    "ink",
    "narrative",
    "editor"
  ],
  "author": "Xteink (fork of inkle/inky by inkle Ltd)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inkly/inky/issues"
  },
  "homepage": "http://www.inklestudios.com/ink",
  "dependencies": {
    "chokidar": "^3.6.0",
    "fuzzaldrin-plus": "^0.6.0",
    "inkjs": "^2.2.3",
    "lodash": "^4.17.21",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.2",
    "chai": "^5.1.1",
    "chai-as-promised": "^7.1.2",
    "electron": "^30.0.4",
    "jsdom": "^24.0.0",
    "markdown-html": "^0.0.8",
    "mocha": "^10.4.0"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  }
}
