{
  "name": "eenky",
  "productName": "EENK Story Editor",
  "version": "0.1.0",
  "description": "Ink editor, EENK compiler, SDL simulator and firmware flasher for the Xteink X4 device",
  "main": "main-process/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0mg/eenky.git"
  },
  "scripts": {
    "postinstall": "node ../build/createDocumentnavigation.js && markdown-html resources/Documentation/WritingWithInk.md -s resources/Documentation/documentation.css -o renderer/public/documentation/embedded.html",
    "setup": "node ../scripts/setup.js",
    "start": "concurrently \"npm run dev --prefix renderer\" \"wait-on http-get://localhost:5173/ && electron main-process/main.js\"",
    "test": "mocha",
    "generate-locale": "node ../build/generateLocale.js",
    "build-package": "node build-package.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.t0mg.eenky",
    "productName": "EENK Story Editor",
    "directories": {
      "output": "../dist-eenky"
    },
    "extraResources": [
      {
        "from": "main-process/ink",
        "to": "ink",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  },
  "keywords": [
    "ink",
    "narrative",
    "editor"
  ],
  "author": "Tom Granger (fork of inkle/inky by inkle Ltd)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/t0mg/eenky/issues"
  },
  "homepage": "http://www.inklestudios.com/ink",
  "dependencies": {
    "chokidar": "^3.6.0",
    "inkjs": "^2.2.3",
    "lodash": "^4.17.21",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.2",
    "chai": "^5.1.1",
    "chai-as-promised": "^7.1.2",
    "concurrently": "^10.0.3",
    "electron": "^30.0.4",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.0.0",
    "markdown-html": "^0.0.8",
    "mocha": "^10.4.0",
    "wait-on": "^9.0.10"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  }
}
